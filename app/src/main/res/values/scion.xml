<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="scion_pill" translatable="false">SCION</string>
    <string name="scion_pill_description" translatable="false">Connected over SCION</string>
    <string name="scion_chat_notice" translatable="false">Messages in this chat are transported via SCION.</string>

    <color name="scion_pill_background">#1A73E8</color>
    <color name="scion_pill_text">#FFFFFF</color>

    <style name="Threema.ScionPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_scion_pill</item>
        <item name="android:contentDescription">@string/scion_pill_description</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">@string/scion_pill</item>
        <item name="android:textColor">@color/scion_pill_text</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
